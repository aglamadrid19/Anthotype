# Anthotype Studio backend configuration.
# Copy to `.env` and fill in.  `.env` is gitignored.

# ---- vision LLM (extracts the page copy + boxes from the design) -----------
# provider: openai (any OpenAI-compatible endpoint) | anthropic | stub
# `stub` needs no key and produces an art-only page -- useful for testing the
# pipeline end to end without a model.
VISION_PROVIDER=openai
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1

# ---- local AntSeed proxy (recommended on this machine) ---------------------
# AntSeed VPR exposes an OpenAI-compatible marketplace on 127.0.0.1:8377.
# Use the vision-capable model pinned there:
#
#   VISION_PROVIDER=openai
#   VISION_MODEL=deepseek-v4-1-flash
#   VISION_API_KEY=antseed-local
#   VISION_BASE_URL=http://127.0.0.1:8377/v1
#
# Check it is up:  curl -s http://127.0.0.1:8377/v1/models | head -c 200

# ---- optional overrides ----------------------------------------------------
# CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# NODE=/path/to/node
# STUDIO_TIMEOUT_TRACE=1800
# STUDIO_TIMEOUT_BUILD=900
